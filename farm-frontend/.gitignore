# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# pipeline artifacts (generated by src/scripts/pipeline stages)
.pipeline/
# content-enrichment corpus + target lists (scraped/DB-derived; never commit)
.enrichment/

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local data-cleanup row backups (recovery only, never commit)
.cleanup-backups/
.audit/

# Generated by scripts/sync-maplibre-worker.mjs on dev/build: a byte-identical
# copy of maplibre's worker from node_modules, served from our own origin
# because v6 resolves it relative to its bundle. Not committed - it must track
# the installed version, and the build always regenerates it.
public/maplibre-gl-worker.mjs
public/maplibre-gl-worker.version
