# Twitter API Configuration
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Claude (content generation)
# Generate with `claude setup-token`; needs a Pro, Max, Ultra, Team or
# Enterprise plan. Requires the Claude Code CLI on PATH (Node >=22).
CLAUDE_CODE_OAUTH_TOKEN=your_claude_code_oauth_token_here


# Farm Companion Configuration
FARM_DATA_URL=https://www.farmcompanion.co.uk/api/farms
FARM_BASE_URL=https://www.farmcompanion.co.uk

# Workflow Configuration
DRY_RUN_MODE=false
POSTING_ENABLED=true
CONTENT_GENERATION_ENABLED=true

# Monitoring & Alerts
SLACK_WEBHOOK_URL=your_slack_webhook_url_here
CRON_SECRET=your_cron_secret_here

# Optional: Upstash Redis for idempotency (prevents double posting)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Timezone Configuration
TARGET_TIMEZONE=Europe/London
POSTING_TIME=09:05

# Content Configuration
MAX_TWEET_LENGTH=280
INCLUDE_IMAGES=true
MAX_IMAGES_PER_TWEET=1

# Deployment / runtime flags (set by the host; override locally only if needed)
NODE_ENV=production
VERCEL_ENV=production
DEBUG=false

# Maintenance Mode (set to 'true' to disable posting)
MAINTENANCE_MODE=false
